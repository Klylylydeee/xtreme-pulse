# Xtreme Pulse environment variables.
# Copy to .env.local (never committed) and fill in the values.
# What each one is for: docs/DEPLOYMENT.md#environment-variables

# MongoDB. Must be a replica set (transactions need one). This default is the local
# single-node replica set rs0 from README.md#getting-started.
MONGODB_URI=mongodb://127.0.0.1:27017/xtreme-pulse?replicaSet=rs0

# Auth.js session secret: a long random value (e.g. `npx auth secret`).
AUTH_SECRET=

# Lets Auth.js accept the host name the app is reached on (internal app, no fixed public URL).
AUTH_TRUST_HOST=true

# Redis for BullMQ background jobs (local Redis or Memurai, maxmemory-policy noeviction).
REDIS_URL=redis://127.0.0.1:6379

# Folder for uploaded and generated files (receipts, 201 files, photos, PDFs).
# Outside public/, git-ignored, and kept across deploys.
FILE_STORAGE_DIR=./storage

# Bootstrap System Administrator, read by `pnpm seed:admin`.
# Remove SEED_ADMIN_PASSWORD from the server once the admin has signed in.
SEED_ADMIN_EMAIL=sysadmin@xtreme-works.com
SEED_ADMIN_PASSWORD=

# Master key for field-level encryption: random 96 bytes, base64. Generate one with
# node -e "console.log(require('crypto').randomBytes(96).toString('base64'))"
# Use a new value on the real server and keep a safe copy.
FIELD_ENCRYPTION_LOCAL_KEY=

# Optional, development only: extra host names (comma-separated, e.g. mybox.local) that other
# devices may open the dev server through. This computer's own IPv4 addresses are allowed already.
DEV_ALLOWED_ORIGINS=
