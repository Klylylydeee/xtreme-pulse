# Xtreme Pulse environment variables.
# Copy to .env.local (never committed) and fill in the values.
# What each one is for: docs/DEPLOYMENT.md#environment-variables

# MongoDB. Must be a replica set (transactions need one).
MONGODB_URI=

# Auth.js session secret: a long random value (e.g. `npx auth secret`).
AUTH_SECRET=

# Redis for BullMQ background jobs.
REDIS_URL=

# Folder for uploaded and generated files (receipts, 201 files, photos, PDFs).
# Outside public/, git-ignored, and kept across deploys.
FILE_STORAGE_DIR=./storage

# Bootstrap System Administrator, read by `pnpm seed:admin`.
# Remove SEED_ADMIN_PASSWORD from the server once the admin has signed in.
SEED_ADMIN_EMAIL=sysadmin@xtreme-works.com
SEED_ADMIN_PASSWORD=

# Master key for field-level encryption: random 96 bytes, base64.
# Use a new value on the real server and keep a safe copy.
FIELD_ENCRYPTION_LOCAL_KEY=
